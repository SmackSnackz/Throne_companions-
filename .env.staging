# Staging Environment Configuration for Throne Companions

# Email Service Configuration (Choose one)
# SendGrid API Key (recommended for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# OR SMTP Configuration (alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=admin@thronecompanions.com

# Mixpanel Configuration
REACT_APP_MIXPANEL_TOKEN=your_mixpanel_token_here

# Environment
NODE_ENV=staging

# Admin Emails (authorized for admin access)
ADMIN_EMAILS=admin@thronecompanions.com,roy@thronecompanions.com,roy.carnell.johnson@gmail.com,roycarnelljohnson@gmail.com